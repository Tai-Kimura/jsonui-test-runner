{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jsonui.dev/schemas/mock.schema.json",
  "title": "JsonUI API Mock Definition",
  "description": "Editor/documentation schema for *.mock.json. The CLI validates via validation/mock.py, not this file.",
  "type": "object",
  "required": ["source", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "swagger": { "type": "string" },
        "operationId": { "type": "string" },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"] },
        "path": { "type": "string" }
      }
    },
    "activeScenario": { "type": "string", "default": "default" },
    "scenarios": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "type": "integer", "minimum": 100, "maximum": 599 },
          "headers": { "type": "object" },
          "body": {},
          "delayMs": { "type": "number", "minimum": 0 },
          "contentType": { "type": "string" },
          "bodyFile": { "type": ["string", "null"] }
        }
      }
    }
  }
}
